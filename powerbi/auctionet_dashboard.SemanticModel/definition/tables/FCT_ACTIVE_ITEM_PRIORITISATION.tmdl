table FCT_ACTIVE_ITEM_PRIORITISATION
	lineageTag: 954557a8-20be-4022-ba02-b890a0ccc35b

	measure 'Shared Top 100' =
			
			CALCULATE(
			    DISTINCTCOUNT(FCT_ACTIVE_ITEM_PRIORITISATION[ITEM_ID]),
			    FILTER(
			        ALL(FCT_ACTIVE_ITEM_PRIORITISATION),
			        FCT_ACTIVE_ITEM_PRIORITISATION[BID_COUNT_RANK] <= 100
			            && FCT_ACTIVE_ITEM_PRIORITISATION[PRIORITISATION_RANK] <= 100
			    )
			)
		formatString: 0
		lineageTag: fc5283aa-13a6-4050-af2e-25e5b4d3d263

	measure 'Ranking-Specific Top 100' =
			
			100 - [Shared Top 100]
		formatString: 0
		lineageTag: eda568d8-986b-4f6b-8dd3-f99400c85185

	measure 'Hours to Close' =
			
			VAR EndTimeUTC =
			    SELECTEDVALUE(FCT_ACTIVE_ITEM_PRIORITISATION[ENDS_AT])
			RETURN
			    IF(
			        NOT ISBLANK(EndTimeUTC),
			        ROUND(
			            (EndTimeUTC - UTCNOW()) * 24,
			            1
			        )
			    )
		lineageTag: eb85bcd4-6b5e-443f-8ea5-1b8d5a56b7c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Engagement Contribution' =
			
			SELECTEDVALUE(
			    FCT_ACTIVE_ITEM_PRIORITISATION[ENGAGEMENT_SCORE]
			) * 0.50
		lineageTag: 6dd43cba-1248-407c-8d82-f8c68bba53ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Category Contribution' =
			
			SELECTEDVALUE(
			    FCT_ACTIVE_ITEM_PRIORITISATION[CATEGORY_PCT_ABOVE_ESTIMATE]
			)
			*
			SELECTEDVALUE(
			    FCT_ACTIVE_ITEM_PRIORITISATION[CATEGORY_CONFIDENCE]
			)
			* 0.25
		lineageTag: 7de2ce0d-0ca0-4c2a-b6da-c5c45ea86a44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'House Contribution' =
			
			SELECTEDVALUE(
			    FCT_ACTIVE_ITEM_PRIORITISATION[HOUSE_PCT_ABOVE_ESTIMATE]
			)
			*
			SELECTEDVALUE(
			    FCT_ACTIVE_ITEM_PRIORITISATION[HOUSE_CONFIDENCE]
			)
			* 0.25
		lineageTag: aaabf597-fa11-497f-980f-61fcda8c158a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

