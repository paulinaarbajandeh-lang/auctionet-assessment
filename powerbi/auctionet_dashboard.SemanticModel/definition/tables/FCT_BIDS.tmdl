table FCT_BIDS
	lineageTag: 0bc63018-e0a1-4b7e-b9ae-4a998beee1ef

	measure 'Total Bids' =
			
			COUNTROWS(FCT_BIDS)
		formatString: 0
		lineageTag: 822fab7c-e1b6-4f85-839a-dfec44202f79

	measure 'Items with Bids' =
			
			DISTINCTCOUNT(FCT_BIDS[ITEM_ID])
		formatString: 0
		lineageTag: 1495019d-f3d3-4aae-b270-486540ff63b8

	measure 'Bid Activity Rate' =
			
			DIVIDE(
			    [Items with Bids],
			    [Total Unique Items]
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: bdba6ea9-662e-41c8-9b8c-ee48270d29a7

	measure 'Average Bids per Item' =
			
			DIVIDE(
			    [Total Bids],
			    [Items with Bids]
			)
		lineageTag: 2cfb9d1f-ba43-4898-b030-99ae21d6c6fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Bids per Active Item' =
			
			DIVIDE(
			    [Total Bids],
			    [Total Unique Items]
			)
		lineageTag: 0742df44-5ee0-4fb0-9179-f98efa500f2f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Highest Bid' =
			
			MAX(FCT_BIDS[BID_AMOUNT])
		lineageTag: e6645b8f-7816-41fe-8c81-2cbaf777d764

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Bid Amount' =
			
			AVERAGE(FCT_BIDS[BID_AMOUNT])
		lineageTag: 37de621c-c69c-4ee0-af1c-6a68ccd44100

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Auto Bids' =
			
			CALCULATE(
			    COUNTROWS(FCT_BIDS),
			    FCT_BIDS[AUTO_BID] = TRUE()
			)
		formatString: 0
		lineageTag: 26944ad6-e4dc-4686-aa8e-c70dd7f88b95

	measure 'Auto Bid Rate' =
			
			DIVIDE(
			    [Auto Bids],
			    [Total Bids]
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 3a618a93-7b75-47ef-8fcb-c3c22587658d

