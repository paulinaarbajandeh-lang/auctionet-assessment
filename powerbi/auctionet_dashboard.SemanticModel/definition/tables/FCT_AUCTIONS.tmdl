table FCT_AUCTIONS
	lineageTag: 4ad561b3-a2e4-4560-87c4-6ebf1a742c09

	measure 'Pricing Gap %' =
			
			AVERAGEX(
			    FILTER(
			        FCT_AUCTIONS,
			        NOT ISBLANK(FCT_AUCTIONS[ESTIMATE]) &&
			        FCT_AUCTIONS[ESTIMATE] > 0 &&
			        NOT ISBLANK(FCT_AUCTIONS[STARTING_BID_AMOUNT])
			    ),
			    DIVIDE(
			        FCT_AUCTIONS[ESTIMATE] - FCT_AUCTIONS[STARTING_BID_AMOUNT],
			        FCT_AUCTIONS[ESTIMATE]
			    )
			)
		formatString: 0.0
		lineageTag: 41810b94-2fcf-458b-a193-d4015920062c

	measure 'Selected Currency' =
			
			SELECTEDVALUE(
			    FCT_AUCTIONS[CURRENCY],
			    "Multiple"
			)
		lineageTag: 78e2eb10-8035-47d4-b78e-1c4001d52071

	measure 'Average Estimate Display' =
			
			FORMAT(
			    AVERAGE(FCT_AUCTIONS[ESTIMATE]),
			    "#,##0"
			)
			& " "
			& [Selected Currency]
		lineageTag: 83f50ccb-5c8c-451c-82c5-27327c391953

	measure 'Average Starting Bid Display' =
			
			FORMAT(
			    AVERAGE(FCT_AUCTIONS[STARTING_BID_AMOUNT]),
			    "#,##0"
			)
			& " "
			& [Selected Currency]
		lineageTag: 4d7d2fc7-aa96-4a49-b642-faa7320d6b34

	measure 'Total Unique Items' =
			
			DISTINCTCOUNT(FCT_AUCTIONS[ITEM_ID])
		formatString: 0
		lineageTag: 56934f62-72c2-4580-b99a-acb7018d1b82

	measure 'Number of Auction Houses' =
			
			DISTINCTCOUNT(FCT_AUCTIONS[COMPANY_ID])
		formatString: 0
		lineageTag: 22143953-3e70-4afc-97ed-0bf5a8047fc7

	measure 'Average Estimate SEK' =
			
			AVERAGE(FCT_AUCTIONS[ESTIMATE_SEK])
		lineageTag: 76b14eb4-e1f2-4fd5-af54-cd7d488fae59

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Starting Bid SEK' =
			
			AVERAGE(FCT_AUCTIONS[STARTING_BID_AMOUNT_SEK])
		lineageTag: c7993ebe-5489-4f17-874f-8f514fecf4f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Pricing Gap %' =
			
			AVERAGEX(
			    FILTER(
			        FCT_AUCTIONS,
			        NOT ISBLANK(FCT_AUCTIONS[ESTIMATE]) &&
			        FCT_AUCTIONS[ESTIMATE] > 0 &&
			        NOT ISBLANK(FCT_AUCTIONS[STARTING_BID_AMOUNT])
			    ),
			    DIVIDE(
			        FCT_AUCTIONS[ESTIMATE] - FCT_AUCTIONS[STARTING_BID_AMOUNT],
			        FCT_AUCTIONS[ESTIMATE]
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0f8d9121-607e-424f-97b4-cf3d8bb32fe6

